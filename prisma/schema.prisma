generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id      Int     @id @default(autoincrement())
  name    String
  country String  @default("Burkina Faso")
  slug    String  @unique
  stores  Store[]
}

model Store {
  id      Int     @id @default(autoincrement())
  cityId  Int
  city    City    @relation(fields: [cityId], references: [id])
  name    String
  address String
  mapUrl  String?
  type    String  @default("Supermarché")
}

# Copie ce fichier en .env et renseigne les valeurs réelles.
# Ne commite JAMAIS le .env (il est ignoré par git).

# URL PostgreSQL (connexion fournie par l'intégration Neon de Vercel).
# Sur Vercel : la variable DATABASE_URL_UNPOOLED est créée automatiquement.
# En local, colle la même valeur dans .env.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-exemple.eu-central-1.aws.neon.tech/fasoyaar?sslmode=require"

# Code d'accès à l'espace admin (>= 9 caractères recommandé)
ADMIN_CODE="123456789"

# Secret HMAC qui signe les sessions admin (génère-en un avec : openssl rand -hex 32)
SESSION_SECRET="change-me-avec-un-vrai-secret-64-hex"

# Copie ce fichier en .env et renseigne les valeurs réelles.
# Ne commite JAMAIS le .env (il est ignoré par git).

# URL de la base PostgreSQL.
# En production (Vercel) : utilise la connexion "pooled" fournie par
# Vercel Postgres ou Neon (Postgres gratuit). En local : la même URL.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="postgresql://user:password@ep-exemple-pooler.eu-central-1.aws.neon.tech/fasoyaar?sslmode=require"

# Code d'accès à l'espace admin (>= 9 caractères recommandé)
ADMIN_CODE="123456789"

# Secret HMAC qui signe les sessions admin (génère-en un avec : openssl rand -hex 32)
SESSION_SECRET="change-me-avec-un-vrai-secret-64-hex"

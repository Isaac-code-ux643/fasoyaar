# Copie ce fichier en .env et renseigne les valeurs réelles.
# Ne commite JAMAIS le .env (il est ignoré par git).

# URL PostgreSQL "pooled" (connexion partagée, recommandée pour serverless).
# Sur Vercel : la variable DATABASE_URL_POOLED est créée automatiquement par
# l'intégration Neon (Storage). En local, colle la même valeur dans .env.
DATABASE_URL_POOLED="postgresql://user:password@ep-exemple-pooler.eu-central-1.aws.neon.tech/fasoyaar?sslmode=require"

# Code d'accès à l'espace admin (>= 9 caractères recommandé)
ADMIN_CODE="123456789"

# Secret HMAC qui signe les sessions admin (génère-en un avec : openssl rand -hex 32)
SESSION_SECRET="change-me-avec-un-vrai-secret-64-hex"
